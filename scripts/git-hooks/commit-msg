#!/bin/bash
# Git commit-msg hook. Rejects commit messages with AI credit lines or emoji,
# and checks the Conventional Commits format.
# Enable once per clone with: git config core.hooksPath scripts/git-hooks

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

if grep -Eiq 'co-authored-by|generated with|generated by (claude|an ai|ai)|noreply@anthropic\.com' "$msg_file"; then
  echo "commit-msg: remove AI credit lines (Co-Authored-By, Generated with, and similar)." >&2
  exit 1
fi

# Reject common emoji byte ranges (UTF-8 sequences starting with 0xF0 0x9F).
if LC_ALL=C grep -q "$(printf '\360\237')" "$msg_file"; then
  echo "commit-msg: emoji are not allowed in commit messages." >&2
  exit 1
fi

# Merge and revert commits created by git are allowed as they are.
case "$first_line" in
  Merge* | Revert*) exit 0 ;;
esac

if ! printf '%s' "$first_line" | grep -Eq '^(feat|fix|test|refactor|docs|build|ci|chore|security|perf)(\([a-z0-9-]+\))?!?: .{1,72}$'; then
  echo "commit-msg: use Conventional Commits, for example 'feat(engine): apply out-of-pocket maximum'." >&2
  echo "commit-msg: got: $first_line" >&2
  exit 1
fi

exit 0
